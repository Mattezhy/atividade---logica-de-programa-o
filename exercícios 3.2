#include <stdio.h>

int main()
{
    char aluno[50];
    float nota;

    printf("Olá, digite por favor seu nome: ");
    scanf("%s", aluno);

    printf("Digite sua nota final: ");
    scanf("%f", &nota); // 1. Changed %i to %f | 2. Added & operator

    if (nota >= 7.0) {
        printf("Aprovado\n");
    } else if (nota >= 5.0) {
        printf("Recuperação\n");
    } else {
        printf("Reprovado\n");
    }

    return 0;
}
